     expect(pipelineSummary(apps)).toMatchObject({ submitted: 1, reviewing: 1, accepted: 1, rejected: 0 });
     expect(pipelineSummary(apps, "Developer")).toMatchObject({ submitted: 1, reviewing: 1, accepted: 0 });
   });
+
+  it("records interview no-shows separately from rejections", () => {
+    const interviewing = { ...base, status: "interview" as const };
+    expect(transition(interviewing, "no_show").status).toBe("no_show");
+    expect(() => transition(base, "no_show")).toThrow(/Allowed/);
+    expect(pipelineSummary([transition(interviewing, "no_show")])).toMatchObject({ no_show: 1, rejected: 0 });
+  });
 });
