@@ -0,0 +1,14 @@
+import { describe, expect, it } from "vitest";
+import { sponsorsByTier } from "./index";
+
+const sponsor = (name: string, tier?: string) => ({ id: "3f2504e0-4f89-11d3-9a0c-0305e82c3301", name, tier });
+
+describe("sponsors", () => {
+  it("groups by tier order with leftovers last", () => {
+    const groups = sponsorsByTier([sponsor("B", "gold"), sponsor("A", "gold"), sponsor("C")], ["gold", "silver"]);
+    expect(groups.map((g) => [g.tier, g.sponsors.map((s) => s.name)])).toEqual([
+      ["gold", ["A", "B"]],
+      ["other", ["C"]],
+    ]);
+  });
+});
