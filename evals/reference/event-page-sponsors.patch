new file mode 100644
index 0000000..a7ac2ae
--- /dev/null
+++ b/modules/sponsors/src/index.ts
@@ -0,0 +1,24 @@
+import type { Event, Sponsor } from "@clubkit/schemas";
+
+export interface SponsorTier {
+  tier: string;
+  sponsors: Sponsor[];
+}
+
+/** Group sponsors in `tierOrder`, sorted by name; unknown or missing tiers go last under "other". */
+export function sponsorsByTier(sponsors: Sponsor[], tierOrder: string[]): SponsorTier[] {
+  const groups = new Map<string, Sponsor[]>([...tierOrder, "other"].map((tier) => [tier, []]));
+  for (const sponsor of sponsors) {
+    const tier = sponsor.tier !== undefined && tierOrder.includes(sponsor.tier) ? sponsor.tier : "other";
+    groups.get(tier)!.push(sponsor);
+  }
+  return [...groups]
+    .filter(([, members]) => members.length > 0)
+    .map(([tier, members]) => ({ tier, sponsors: members.sort((a, b) => a.name.localeCompare(b.name)) }));
+}
+
+/** The sponsors an event lists, in the event's order. Ids with no matching sponsor are skipped. */
+export function eventSponsors(event: Event, sponsors: Sponsor[]): Sponsor[] {
+  const byId = new Map(sponsors.map((s) => [s.id, s]));
+  return [...new Set(event.sponsorIds ?? [])].flatMap((id) => byId.get(id) ?? []);
+}
diff --git a/modules/sponsors/src/sponsors.test.ts b/modules/sponsors/src/sponsors.test.ts
new file mode 100644
index 0000000..ea3a4e1
--- /dev/null
+++ b/modules/sponsors/src/sponsors.test.ts
@@ -0,0 +1,22 @@
+import { describe, expect, it } from "vitest";
+import { eventSponsors, sponsorsByTier } from "./index";
+
+const sponsor = (name: string, tier?: string) => ({ id: "3f2504e0-4f89-11d3-9a0c-0305e82c3301", name, tier });
+
+describe("sponsors", () => {
+  it("groups by tier order with leftovers last", () => {
+    const groups = sponsorsByTier([sponsor("B", "gold"), sponsor("A", "gold"), sponsor("C")], ["gold", "silver"]);
+    expect(groups.map((g) => [g.tier, g.sponsors.map((s) => s.name)])).toEqual([
+      ["gold", ["A", "B"]],
+      ["other", ["C"]],
+    ]);
+  });
+
+  it("lists an event's sponsors in the event's order", () => {
+    const acme = { id: "5d1c9a7e-2b4f-4c6a-8e0d-3f5b7a9c1e2d", name: "Acme" };
+    const zeta = { id: "9b2f8d1e-1c4a-4f6e-8a3b-2d5c7e9f1a0b", name: "Zeta" };
+    const event = { id: acme.id, name: "Hackathon", description: "", date: "2026-11-13", sponsorIds: [zeta.id, acme.id] };
+    expect(eventSponsors(event, [acme, zeta]).map((s) => s.name)).toEqual(["Zeta", "Acme"]);
+    expect(eventSponsors({ ...event, sponsorIds: undefined }, [acme])).toEqual([]);
+  });
+});
