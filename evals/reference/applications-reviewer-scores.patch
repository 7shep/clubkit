diff --git a/modules/applications/migrations/0002_review_scores.sql b/modules/applications/migrations/0002_review_scores.sql
new file mode 100644
index 0000000..c5f7b98
--- /dev/null
+++ b/modules/applications/migrations/0002_review_scores.sql
@@ -0,0 +1,13 @@
+-- Reviewer scores are part of an applicant's record: RLS is on with no policies,
+-- so only the service role can read or write.
+create table if not exists public.review_scores (
+  id uuid primary key default gen_random_uuid(),
+  application_id uuid not null references public.applications (id) on delete cascade,
+  reviewer text not null,
+  score integer not null check (score between 1 and 5),
+  comment text,
+  scored_at timestamptz not null default now(),
+  unique (application_id, reviewer)
+);
+
+alter table public.review_scores enable row level security;
