@@ -1,4 +1,4 @@
-import { ApplicationSchema, type Application, type ApplicationStatus } from "@clubkit/schemas";
+import { ApplicationSchema, type Application, type ApplicationStatus, type ReviewScore } from "@clubkit/schemas";
 
 /** Validate an incoming application. New submissions must arrive with status "submitted". */
 export function parseApplication(input: unknown, options: { deadline?: string; now?: Date } = {}): Application {
@@ -45,3 +45,21 @@ export function pipelineSummary(applications: Application[], position?: string):
   }
   return summary;
 }
+
+/**
+ * Average score and reviewer count per application id. When a reviewer scores
+ * the same applicant more than once, only their last score (in array order) counts.
+ */
+export function averageScores(scores: ReviewScore[]): Record<string, { average: number; count: number }> {
+  const latest = new Map<string, Map<string, number>>();
+  for (const { applicationId, reviewer, score } of scores) {
+    if (!latest.has(applicationId)) latest.set(applicationId, new Map());
+    latest.get(applicationId)!.set(reviewer, score);
+  }
+  return Object.fromEntries(
+    [...latest].map(([id, byReviewer]) => {
+      const values = [...byReviewer.values()];
+      return [id, { average: values.reduce((sum, v) => sum + v, 0) / values.length, count: values.length }];
+    }),
+  );
+}
