@@ -0,0 +1,8 @@
+-- Hiring rounds: a closed position can reopen without touching earlier decisions.
+-- The same email may apply once per position per round.
+alter table public.applications
+  add column if not exists round integer not null default 1 check (round > 0);
+
+alter table public.applications drop constraint if exists applications_email_position_key;
+alter table public.applications
+  add constraint applications_email_position_round_key unique (email, position, round);
