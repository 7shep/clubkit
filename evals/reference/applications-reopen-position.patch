diff --git a/modules/applications/src/index.ts b/modules/applications/src/index.ts
index a136d41..63d7c18 100644
--- a/modules/applications/src/index.ts
+++ b/modules/applications/src/index.ts
@@ -37,11 +37,27 @@ export function transition(application: Application, to: ApplicationStatus): App
   return { ...application, status: to };
 }
 
-/** Count applications per status, optionally for one position. Every status appears, even at zero. */
-export function pipelineSummary(applications: Application[], position?: string): Record<ApplicationStatus, number> {
+const roundOf = (application: Application) => application.round ?? 1;
+
+/**
+ * Count applications per status, optionally for one position and hiring round.
+ * Every status appears, even at zero.
+ */
+export function pipelineSummary(applications: Application[], position?: string, round?: number): Record<ApplicationStatus, number> {
   const summary = Object.fromEntries(Object.keys(transitions).map((s) => [s, 0])) as Record<ApplicationStatus, number>;
   for (const application of applications) {
-    if (position === undefined || application.position === position) summary[application.status]++;
+    if (position !== undefined && application.position !== position) continue;
+    if (round !== undefined && roundOf(application) !== round) continue;
+    summary[application.status]++;
   }
   return summary;
 }
+
+/**
+ * The round number to use when reopening `position`: one past the latest round
+ * anyone applied in, or 1 if nobody has. Past rounds and their decisions are untouched.
+ */
+export function nextRound(applications: Application[], position: string): number {
+  const rounds = applications.filter((a) => a.position === position).map(roundOf);
+  return rounds.length === 0 ? 1 : Math.max(...rounds) + 1;
+}
