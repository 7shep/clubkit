@@ -0,0 +1,8 @@
+import { SubscriberSchema, type Subscriber } from "@clubkit/schemas";
+
+/** Validate a signup and add it to `existing`. A repeat signup (same email, any case) changes nothing. */
+export function subscribe(input: unknown, existing: Subscriber[]): Subscriber[] {
+  const subscriber = SubscriberSchema.parse(input);
+  if (existing.some((s) => s.email.toLowerCase() === subscriber.email)) return existing;
+  return [...existing, subscriber];
+}
diff --git a/modules/newsletter/src/newsletter.test.ts b/modules/newsletter/src/newsletter.test.ts
new file mode 100644
index 0000000..94c582e
--- /dev/null
+++ b/modules/newsletter/src/newsletter.test.ts
@@ -0,0 +1,11 @@
+import { describe, expect, it } from "vitest";
+import { subscribe } from "./index";
+
+describe("newsletter", () => {
+  it("adds new subscribers and ignores repeats", () => {
+    const one = subscribe({ name: "Ana", email: "Ana@Example.com " }, []);
+    expect(one).toEqual([{ name: "Ana", email: "ana@example.com" }]);
+    expect(subscribe({ name: "Ana again", email: "ana@example.com" }, one)).toBe(one);
+    expect(() => subscribe({ name: "", email: "nope" }, [])).toThrow();
+  });
+});
