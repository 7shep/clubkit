+/** The calendar date (YYYY-MM-DD) in `timezone` at the instant `now`. */
+export function dateInTimezone(now: Date, timezone: string): string {
+  // en-CA formats dates as YYYY-MM-DD.
+  return new Intl.DateTimeFormat("en-CA", { timeZone: timezone, year: "numeric", month: "2-digit", day: "2-digit" }).format(now);
+}
+
+/** `upcomingEvents` for callers that know only the current instant and the club's timezone. */
+export function upcomingEventsAt(events: Event[], now: Date, timezone: string): Event[] {
+  return upcomingEvents(events, dateInTimezone(now, timezone));
+}
