diff --git a/modules/events/migrations/0002_event_rsvps.sql b/modules/events/migrations/0002_event_rsvps.sql
new file mode 100644
index 0000000..c74d593
--- /dev/null
+++ b/modules/events/migrations/0002_event_rsvps.sql
@@ -0,0 +1,11 @@
+-- RSVPs hold names and emails: RLS is on with no policies, so only the service role can read or write.
+create table if not exists public.event_rsvps (
+  id uuid primary key default gen_random_uuid(),
+  event_id uuid not null references public.events (id) on delete cascade,
+  name text not null,
+  email text not null,
+  created_at timestamptz not null default now(),
+  unique (event_id, email)
+);
+
+alter table public.event_rsvps enable row level security;
