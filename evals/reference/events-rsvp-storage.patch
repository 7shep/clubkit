diff --git a/modules/events/src/index.ts b/modules/events/src/index.ts
index 3d4ba95..86eaa26 100644
--- a/modules/events/src/index.ts
+++ b/modules/events/src/index.ts
@@ -1,4 +1,4 @@
-import { EventSchema, type Event } from "@clubkit/schemas";
+import { EventSchema, type Event, type Rsvp } from "@clubkit/schemas";
 
 /** Validate untrusted input (form data, agent output, a database row) into an Event. Throws ZodError on bad input. */
 export function parseEvent(input: unknown): Event {
@@ -18,6 +18,23 @@ export function rsvpSpotsLeft(event: Event, rsvpCount: number): number | null {
   return Math.max(0, event.rsvpCap - rsvpCount);
 }
 
+/**
+ * Return `existing` plus `rsvp`, or throw if the event is full or the email has
+ * already RSVP'd. Only RSVPs for this event count toward its cap.
+ */
+export function addRsvp(event: Event, existing: Rsvp[], rsvp: Rsvp): Rsvp[] {
+  if (rsvp.eventId !== event.id) throw new Error(`RSVP is for event ${rsvp.eventId}, not ${event.id}`);
+  const forEvent = existing.filter((r) => r.eventId === event.id);
+  const email = rsvp.email.toLowerCase();
+  if (forEvent.some((r) => r.email.toLowerCase() === email)) {
+    throw new Error(`${rsvp.email} has already RSVP'd to "${event.name}"`);
+  }
+  if (rsvpSpotsLeft(event, forEvent.length) === 0) {
+    throw new Error(`"${event.name}" is full (${event.rsvpCap} spots)`);
+  }
+  return [...existing, rsvp];
+}
+
 const escapeIcs = (value: string) =>
   value.replace(/\\/g, "\\\\").replace(/;/g, "\\;").replace(/,/g, "\\,").replace(/\r?\n/g, "\\n");
 
