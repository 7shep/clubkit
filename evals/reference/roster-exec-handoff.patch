+-- Every exec handoff, with the date the incoming member takes over. Service role only.
+create table if not exists public.role_handoffs (
+  id uuid primary key default gen_random_uuid(),
+  role text not null,
+  from_member_id uuid not null references public.members (id),
+  to_member_id uuid not null references public.members (id),
+  handed_off_on date not null,
+  created_at timestamptz not null default now(),
+  check (from_member_id <> to_member_id)
+);
+
+alter table public.role_handoffs enable row level security;
