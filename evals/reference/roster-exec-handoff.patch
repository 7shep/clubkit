+-- Generalized from QWeb's team_members table. The team page is public; emails are not.
+create table if not exists public.members (
+  id uuid primary key default gen_random_uuid(),
+  full_name text not null,
+  pronouns text,
+  email text not null unique,
+  role text not null,
+  team text,
+  joined_on date,
+  linkedin_url text,
+  github_url text,
+  created_at timestamptz not null default now()
+);
+
+alter table public.members enable row level security;
+
+create policy "Team page is publicly readable"
+  on public.members for select
+  to anon, authenticated
+  using (true);
+
+-- Column privileges: the anon and authenticated roles can read every column except email.
+revoke all on public.members from anon, authenticated;
+grant select (id, full_name, pronouns, role, team, joined_on, linkedin_url, github_url)
+  on public.members to anon, authenticated;
