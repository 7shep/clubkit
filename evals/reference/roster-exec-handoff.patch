--- /dev/null
+++ b/modules/roster/src/index.ts
@@ -0,0 +1,36 @@
+import { RoleHandoffSchema, type Member, type RoleHandoff } from "@clubkit/schemas";
+
+export type PublicProfile = Omit<Member, "email">;
+
+/** Members for a public team page, sorted by name, with emails removed. */
+export function publicProfiles(members: Member[]): PublicProfile[] {
+  return members
+    .map(({ email: _email, ...profile }) => profile)
+    .sort((a, b) => a.fullName.localeCompare(b.fullName));
+}
+
+/** The role an outgoing exec holds after handing off. */
+export const ALUMNI_ROLE = "Alumni";
+
+/**
+ * Move `role` from one member to another on a date. Returns updated copies of the
+ * members (the outgoing member becomes "Alumni") and the handoff record to store.
+ * Throws if the outgoing member does not hold the role or either member is unknown.
+ */
+export function handOffRole(members: Member[], request: RoleHandoff): { members: Member[]; handoff: RoleHandoff } {
+  const handoff = RoleHandoffSchema.parse(request);
+  const from = members.find((m) => m.id === handoff.fromMemberId);
+  const to = members.find((m) => m.id === handoff.toMemberId);
+  if (!from) throw new Error(`No member with id ${handoff.fromMemberId}`);
+  if (!to) throw new Error(`No member with id ${handoff.toMemberId}`);
+  if (from.id === to.id) throw new Error("A member cannot hand a role to themselves");
+  if (from.role !== handoff.role) {
+    throw new Error(`${from.fullName} holds "${from.role}", not "${handoff.role}"`);
+  }
+  return {
+    members: members.map((m) =>
+      m.id === from.id ? { ...m, role: ALUMNI_ROLE } : m.id === to.id ? { ...m, role: handoff.role } : m,
+    ),
+    handoff,
+  };
+}
