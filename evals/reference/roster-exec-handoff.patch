@@ -0,0 +1,27 @@
+import { describe, expect, it } from "vitest";
+import { handOffRole, publicProfiles } from "./index";
+
+const member = (fullName: string, id = "3f2504e0-4f89-11d3-9a0c-0305e82c3301") => ({
+  id,
+  fullName,
+  email: `${fullName.toLowerCase()}@example.com`,
+  role: "Developer",
+});
+
+describe("roster", () => {
+  it("sorts the team page by name and hides emails", () => {
+    const profiles = publicProfiles([member("Zoe"), member("Ana")]);
+    expect(profiles.map((p) => p.fullName)).toEqual(["Ana", "Zoe"]);
+    expect(profiles.every((p) => !("email" in p))).toBe(true);
+  });
+
+  it("hands a role to the next exec and records the date", () => {
+    const outgoing = { ...member("Ana"), role: "VP Events" };
+    const incoming = member("Bo", "5d1c9a7e-2b4f-4c6a-8e0d-3f5b7a9c1e2d");
+    const request = { role: "VP Events", fromMemberId: outgoing.id, toMemberId: incoming.id, on: "2027-05-01" };
+    const result = handOffRole([outgoing, incoming], request);
+    expect(result.members.map((m) => m.role)).toEqual(["Alumni", "VP Events"]);
+    expect(result.handoff).toEqual(request);
+    expect(() => handOffRole([outgoing, incoming], { ...request, role: "President" })).toThrow(/holds "VP Events"/);
+  });
+});
