 /** Validate untrusted input (form data, agent output, a database row) into an Event. Throws ZodError on bad input. */
 export function parseEvent(input: unknown): Event {
@@ -18,6 +18,14 @@ export function rsvpSpotsLeft(event: Event, rsvpCount: number): number | null {
   return Math.max(0, event.rsvpCap - rsvpCount);
 }
 
+/** Record someone arriving at `event`. Checking in twice (same email, any case) counts once. */
+export function checkIn(event: Event, existing: CheckIn[], person: { name: string; email: string }): CheckIn[] {
+  const entry = CheckInSchema.parse({ ...person, eventId: event.id });
+  const email = entry.email.toLowerCase();
+  if (existing.some((c) => c.eventId === event.id && c.email.toLowerCase() === email)) return existing;
+  return [...existing, entry];
+}
+
 const escapeIcs = (value: string) =>
   value.replace(/\\/g, "\\\\").replace(/;/g, "\\;").replace(/,/g, "\\,").replace(/\r?\n/g, "\\n");
 
