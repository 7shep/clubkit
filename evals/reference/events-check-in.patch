diff --git a/modules/events/migrations/0002_event_check_ins.sql b/modules/events/migrations/0002_event_check_ins.sql
new file mode 100644
index 0000000..3d546cf
--- /dev/null
+++ b/modules/events/migrations/0002_event_check_ins.sql
@@ -0,0 +1,12 @@
+-- Who attended each event. Check-ins hold names and emails: RLS is on with no
+-- policies, so only the service role can read or write.
+create table if not exists public.event_check_ins (
+  id uuid primary key default gen_random_uuid(),
+  event_id uuid not null references public.events (id) on delete cascade,
+  name text not null,
+  email text not null,
+  checked_in_at timestamptz not null default now(),
+  unique (event_id, email)
+);
+
+alter table public.event_check_ins enable row level security;
