diff --git a/modules/applications/src/index.ts b/modules/applications/src/index.ts
index a136d41..d33ccfb 100644
--- a/modules/applications/src/index.ts
+++ b/modules/applications/src/index.ts
@@ -45,3 +45,16 @@ export function pipelineSummary(applications: Application[], position?: string):
   }
   return summary;
 }
+
+const csvField = (value: string) => (/[",\r\n]/.test(value) ? `"${value.replace(/"/g, '""')}"` : value);
+
+/**
+ * Accepted applicants as CSV (`name,email,position`), optionally for one position.
+ * Only contact details leave the module: answers, program, and graduation year are never exported.
+ */
+export function acceptedApplicantsCsv(applications: Application[], position?: string): string {
+  const rows = applications
+    .filter((a) => a.status === "accepted" && (position === undefined || a.position === position))
+    .map((a) => [a.fullName, a.email, a.position].map(csvField).join(","));
+  return ["name,email,position", ...rows].join("\r\n") + "\r\n";
+}
