diff --git a/modules/events/src/next.ts b/modules/events/src/next.ts
new file mode 100644
index 0000000..9db0c63
--- /dev/null
+++ b/modules/events/src/next.ts
@@ -0,0 +1,34 @@
+import type { Event } from "@clubkit/schemas";
+
+/** The club's default timezone, matching `config.timezone` in module.json. */
+export const DEFAULT_TIMEZONE = "America/Toronto";
+
+/** The local date and HH:MM in `timezone` at the instant `now`. */
+function localNow(now: Date, timezone: string): { date: string; time: string } {
+  const parts = Object.fromEntries(
+    new Intl.DateTimeFormat("en-CA", {
+      timeZone: timezone,
+      year: "numeric",
+      month: "2-digit",
+      day: "2-digit",
+      hour: "2-digit",
+      minute: "2-digit",
+      hourCycle: "h23",
+    })
+      .formatToParts(now)
+      .map((p) => [p.type, p.value]),
+  );
+  return { date: `${parts.year}-${parts.month}-${parts.day}`, time: `${parts.hour}:${parts.minute}` };
+}
+
+/**
+ * The next `count` events that haven't started yet at `now`, in the club's
+ * timezone, soonest first. All-day events count as upcoming for their whole day.
+ */
+export function nextEvents(events: Event[], now: Date, count: number, timezone = DEFAULT_TIMEZONE): Event[] {
+  const local = localNow(now, timezone);
+  return events
+    .filter((e) => e.date > local.date || (e.date === local.date && (e.startTime === undefined || e.startTime >= local.time)))
+    .sort((a, b) => a.date.localeCompare(b.date) || (a.startTime ?? "").localeCompare(b.startTime ?? ""))
+    .slice(0, count);
+}
