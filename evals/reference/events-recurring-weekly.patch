+/**
+ * Expand a weekly event into one event per week, from `event.date` through
+ * `until` (YYYY-MM-DD, inclusive). Each occurrence keeps every other field.
+ */
+export function weeklyOccurrences(event: Event, until: string): Event[] {
+  const occurrences: Event[] = [];
+  const date = new Date(`${event.date}T00:00:00Z`);
+  for (let day = event.date; day <= until; day = date.toISOString().slice(0, 10)) {
+    occurrences.push({ ...event, date: day });
+    date.setUTCDate(date.getUTCDate() + 7);
+  }
+  return occurrences;
+}
+
 const escapeIcs = (value: string) =>
   value.replace(/\\/g, "\\\\").replace(/;/g, "\\;").replace(/,/g, "\\,").replace(/\r?\n/g, "\\n");
 
